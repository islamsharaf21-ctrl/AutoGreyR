  "implementation_conventions": {
    "action_score": "mu_hat_z + lambda*log1p(tau_h)*p_bad",
    "action_support": "POOLED group requires >=30 distinct TRAIN parents in fold; BY_H group\u00d7h requires >=20; parent decision supported iff every post-dedup eligible action is supported",
    "by_h_tail": "separate h=1,3,5 regressor/classifier and h-specific tau_h",
    "candidate_relative_metrics": "candidate mean/CVaR divided by GLOBAL_RANK_V2 on the same candidate-supported parent IDs",
    "cvar90": "arithmetic mean of worst ceil(0.10*N) supported parent regrets",
    "global_rank_v2": "per fold, weighted mean eligible regret per group from TRAIN rows only using action_row_weight; >=30 distinct TRAIN parents/group; lower mean wins with frozen group-order tie break",
    "input_filter": "parse canonical target-free action CSV and immediately discard v2_split != V2_TRAIN before model-data construction; labels file contains TRAIN only",
    "join_key": "selector_row_hash; assert parent/action/h/fold/weight identity",
    "one_class_tail": "no classifier fit; p_bad is exactly the sole class value 0 or 1",
    "ordering": "canonical records sort by parent_id then frozen structural-group order SG01..SG10",
    "p90": "numpy.quantile(q=.90, method=linear)",
    "parent_weight": "action_row_weight=1/k_i supplied by Step5D-A; used as sample_weight; assert each TRAIN parent sums to 1",
    "pooled_tail": "h-specific tau_h labels/penalty, one pooled regressor and one pooled classifier across h",
    "preprocessing": "within each fitted head's TRAIN rows only; invalid numeric values represented as NaN; unweighted median of finite valid TRAIN values per predictor; all-invalid predictor -> 0; no scaling; masks retained",
    "result_files": "no timestamps/output-dir strings in canonical files; stable JSON sort_keys and LF CSV for clean-process byte reproduction",
    "rf_constructor": "criterion squared_error/gini, bootstrap true, oob false, n_jobs=-1, random_state=62291, max_samples=None, ccp_alpha=0, monotonic_cst=None; other constructor fields explicit in harness",
    "selection": "coverage>=0.995; J=max(rho_mean,rho_tail); near set J<=minJ+0.01; minimum rho_mean in near set; only numerical ties within 1e-12 use frozen simplicity",
    "simplicity_tie_only": "GLOBAL_RANK_V2, then V1_STYLE_RF_REGRET, then ACTION_RF; within ACTION: BASE before FULL, POOLED before BY_H, lower lambda, depth8 before None, leaf.03 before .01",
    "train_gate": "rho_mean<1 AND rho_tail<=1",
    "v1_style": "10 group-specific RF regressors; target frozen target_log1p_regret; 56 predictors=23 values+23 masks+10 eligibility bits; group-local fold median imputation; sample_weight=action_row_weight; minimum predicted target wins with group-order tie break",
    "weighted_q90": "per training fold and h across all TRAIN action rows; stable ascending regret sort; first regret at cumulative positive action_row_weight >= 0.90 total; no interpolation; bad=1 iff regret>tau_h",
    "zero_regret": "regret <= 1e-15"
  },
